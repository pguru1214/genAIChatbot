{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "problemMatcher": []
    },
    {
      "label": "Backend: install dependencies",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "problemMatcher": []
    }
  ]
}
