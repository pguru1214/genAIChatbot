# Copy to .env. Never put secrets in frontend files.
# demo = clearly labelled sample data; live = real public APIs + Gemini.
APP_MODE=demo
GEMINI_API_KEY=
# Optional alternate credential for transient failures; never sent to the browser.
# Uses GEMINI_FALLBACK_MODEL if set, otherwise the primary model. No 429 retry.
GEMINI_FALLBACK_API_KEY=
# Set an available model eligible for your account's free tier before live mode.
GEMINI_MODEL=
# Optional alternate model for temporary 5xx outages; verify account eligibility.
GEMINI_FALLBACK_MODEL=
# Free Geoapify key: attractions, restaurants, accommodation and road routing.
# Without it, attractions use Wikipedia; food/stays show map verification links.
GEOAPIFY_API_KEY=
# Shared local allowance below the provider free tier; includes attraction lookups.
# Other apps using the same provider account are outside this ledger.
GEOAPIFY_DAILY_CREDIT_LIMIT=2400
# Optional PostgreSQL (no Docker required if you have PostgreSQL installed/hosted).
# DATABASE_URL=postgresql+psycopg://tripweave:tripweave_local_only@localhost:5432/tripweave
# SQLite is the default zero-configuration development fallback.
DATABASE_URL=sqlite:///./tripweave.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
