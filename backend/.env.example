# Copy to .env. Never put secrets in frontend files.
# demo = clearly labelled sample data; live = real public APIs + Gemini.
APP_MODE=demo
GEMINI_API_KEY=
# Set an available model eligible for your account's free tier before live mode.
GEMINI_MODEL=
# Optional PostgreSQL (no Docker required if you have PostgreSQL installed/hosted).
# DATABASE_URL=postgresql+psycopg://tripweave:tripweave_local_only@localhost:5432/tripweave
# SQLite is the default zero-configuration development fallback.
DATABASE_URL=sqlite:///./tripweave.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
